# Local dev values — in AWS these are injected by ECS from Secrets Manager
# and Terraform outputs (see infra/outputs.tf), not from a .env file.

DATABASE_URL="postgresql://erp_admin:changeme@localhost:5432/erp"
PORT=3000
AWS_REGION=us-east-1

COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# From `terraform output cognito_client_secret` (sensitive) — used only
# server-side to exchange an auth code for tokens, see AuthController.
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
# From `terraform output cognito_hosted_ui_domain` (no https:// prefix).
COGNITO_DOMAIN=erp-dev-auth.auth.us-east-1.amazoncognito.com
# Must exactly match a `cognito_callback_urls` entry in infra/variables.tf.
COGNITO_CALLBACK_URL=https://api.example.com/auth/callback
# Where AuthController sends the browser after login/logout.
FRONTEND_URL=https://app.example.com

DOCUMENTS_BUCKET=erp-dev-documents-000000000000
