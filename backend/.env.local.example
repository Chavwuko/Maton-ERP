# For fully-local testing on your own PC — no AWS account needed.
# Copy this to `.env` (overwriting it) to use this instead of the AWS setup.

AUTH_MODE=local

DATABASE_URL="postgresql://erp_admin:local_dev_password@localhost:5432/erp"
PORT=3000

# Unused while AUTH_MODE=local, but the app still reads them from .env —
# leave as placeholders, they're never contacted.
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=unused-in-local-mode
COGNITO_CLIENT_ID=unused-in-local-mode

# Document Control file storage. S3_ENDPOINT points StorageService at the
# MinIO container from docker-compose.yml instead of real AWS S3 — the
# bucket below is created automatically on first boot.
DOCUMENTS_BUCKET=erp-local-documents
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
